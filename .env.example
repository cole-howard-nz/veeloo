# --- Instagram (Graph API) ---
# One-time bootstrap token, from Meta App Dashboard > your app > Instagram > API setup > "Generate token".
# Used locally, and in production before the auto-refresh cron has run for the first time.
INSTAGRAM_ACCESS_TOKEN=
# The IG professional account's numeric ID (same "API setup" screen).
INSTAGRAM_USER_ID=

# --- Auto-refresh (production, Vercel only — see README/setup notes) ---
# Personal Access Token from vercel.com/account/tokens. Lets the refresh cron write the
# renewed token into Edge Config so it's live without a redeploy.
VERCEL_API_TOKEN=
# The linked Edge Config store's ID (Storage tab in the Vercel dashboard).
EDGE_CONFIG_ID=
# Connection string Vercel adds automatically once an Edge Config store is linked to this
# project — used to READ the current token at request time. Leave blank locally.
EDGE_CONFIG=
# Any random string. Set the same value in the Vercel project's env vars; Vercel Cron then
# sends it automatically as `Authorization: Bearer <value>`, so only Vercel's own scheduler
# can trigger the refresh endpoint.
CRON_SECRET=
