# --- Admin CMS (add/edit/remove vehicle listings, at /admin) ---
# Shared password for the single admin login. Use a long random passphrase - there are no
# per-user accounts, so this is the only thing gating write access to the site's inventory.
ADMIN_PASSWORD=
# Random secret used to HMAC-sign the admin session cookie. Generate with e.g.
# `openssl rand -hex 32`. Changing this instantly logs everyone out.
ADMIN_SESSION_SECRET=
# Auto-populated once a Vercel Blob store is connected to this project (Vercel dashboard >
# Storage > Create Database > Blob). Used to upload/delete vehicle photos from the admin UI.
# For local dev, copy the value from Project Settings > Environment Variables after connecting.
BLOB_READ_WRITE_TOKEN=
